# App
NODE_ENV=development
APP_NAME=Nalarin
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nalarin

# Database
DATABASE_URL=mysql://root:password@127.0.0.1:3306/nalarin

# Auth / Session
SESSION_PASSWORD=replace-with-at-least-32-characters-session-secret
SESSION_COOKIE_NAME=nalarin_session
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=10

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Harus sama persis dengan callback yang didaftarkan di Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email
EMAIL_PROVIDER=resend
MAIL_FROM="Nalarin <no-reply@example.com>"
RESEND_API_KEY=replace-with-resend-api-key

# SMTP fallback (optional if not using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Midtrans
PAYMENT_GATEWAY_ENABLED=true
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_CLIENT_KEY=replace-with-midtrans-client-key
MIDTRANS_MERCHANT_ID=replace-with-midtrans-merchant-id

# Manual payment fallback (required when PAYMENT_GATEWAY_ENABLED=false)
MANUAL_PAYMENT_WHATSAPP_NUMBER=6281234567890
EWALLET_SHOPEEPAY_PHONE=081234567890
EWALLET_GOPAY_PHONE=081234567890
EWALLET_OVO_PHONE=081234567890

# AI Provider
AI_PROVIDER=openai-compatible
AI_API_KEY=replace-with-ai-api-key
AI_BASE_URL=
AI_MODEL_QUESTION_GENERATION=gpt-4.1-mini
AI_MODEL_EXPLANATION_GENERATION=gpt-4.1-mini
AI_MODEL_GRADING=gpt-4.1-mini

# Upload / Asset Base URL (optional, if files are stored outside local app)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_BASE_URL=http://localhost:3000/uploads
FILE_STORAGE_PUBLIC_DIR=public/uploads

# Cron / Internal Jobs
CRON_SECRET=replace-with-random-cron-secret
PRACTICE_ABANDONED_HOURS=24
TRYOUT_ABANDONED_HOURS=72
SUBSCRIPTION_EXPIRY_CRON_ENABLED=true

# Rate Limits
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
FORGOT_PASSWORD_MAX_REQUESTS_PER_HOUR=3
RESEND_VERIFICATION_MAX_REQUESTS_PER_HOUR=3
AI_GENERATE_QUESTION_MAX_PER_DAY=50
AI_GENERATE_EXPLANATION_MAX_PER_DAY=100
AI_GRADING_MAX_PER_DAY=200
